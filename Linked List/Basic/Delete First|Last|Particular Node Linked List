     if(head) {
         //Only 1 node is present
        if(!head->next) {
            delete head;
        } 
        //More than 1 nodes present.
        else { 
            Node* prev = NULL;
            Node* tail = head;
            while(tail->next) {
                prev = tail;
                tail = tail->next;
            }
            prev->next = tail->next;
            delete tail;     
        }
    }
}

Node* deleteAtPos(Node* head, int pos) {
    if(pos == 1) {
        Node* temp = head;
        head = head->next;
        delete temp;
    } else {
        Node* prev = NULL;
        Node* tail = head;
        
        pos--;
        while(pos--) {
            prev = tail;
            tail = tail->next;
        }
        prev->next = tail->next;
        delete tail;
    }
    return head;
}

Node* deleteNodePosRecursion(Node* curr, int pos) {
    if(pos == 1) {
        Node* temp = curr->next;
        delete curr;
        return temp;
    } else {
        curr->next = deleteNodePosRecursion(curr->next, pos-1);
        return curr;
    }
}

