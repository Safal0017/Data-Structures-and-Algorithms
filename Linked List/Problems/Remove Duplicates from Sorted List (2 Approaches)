        // Approach 2: In-Place (Deleting node-Efficient Memory Handling)
        ListNode* prev = head;
        ListNode* curr = head->next;

        while(curr) {
            if(curr->val == prev->val) {
                prev->next = curr->next;
                delete curr;
                curr = prev->next;
            } else {
                prev = prev->next;
                curr = curr->next;
            }
        }

        return head;
