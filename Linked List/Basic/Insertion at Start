  public:
    int data;
    Node* next;

    // Default constructor
    Node() {
        data = 0;
        next = NULL;
    }

    // Parameterised Constructor
    Node(int data) {
        this->data = data;
        this->next = NULL;
    }
};
*/
class Solution {
  public:
    Node *insertAtStart(Node *head, int x) {
        // Code here
        if(!head)
        return new Node(x);
        else {
            Node* temp = new Node(x);
            temp->next = head;
            head = temp;
        }
    }
};
