Burning Tree: Recursive Way:
Rohit's Negi Soln:
T.C: 0(N)
S.C: 0(N)

  /**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left),
 * right(right) {}
 * };
 */
class Solution {

    //3rd Solution, Recursive way: Rohit Negi's 
    int HeightBT(TreeNode* root) {
        if(!root)
        return 0;

        return 1+max(HeightBT(root->left), HeightBT(root->right));
    }

    int BurnTree(TreeNode* root, int &timer, int target, TreeNode* &targetNode) {
        if(!root)
        return 0;

        if(root->val == target) {
            targetNode = root;
            return -1;
        }
        
        int left = BurnTree(root->left, timer, target, targetNode);
        int right = BurnTree(root->right, timer, target, targetNode);

        if(left<0) {
            timer = max(timer, right-left);
            return left-1;
        }

        if(right<0) {
            timer = max(timer, left-right);
            return right-1;
        }

        return 1+max(left, right);
    }

public:
    int amountOfTime(TreeNode* root, int start) {

        //3rd Soln:
        //Recursive Way:
        //Declare timer,
        //At Each node: 2 Ques:
        //i. if the burn is coming from your side, let me know the seconds will it take to burn me,
        //ii. if not, let me know the subtree height.
        //To differentiate we will return burn as -ve val, and height as positive val,
        //And lastly, will calculate the height of subtree beneath the burning/target node.
        //will return the max(height, timer);

        if(!root)
        return 0;

        int timer = INT_MIN;
        TreeNode* targetNode;
        BurnTree(root, timer, start, targetNode);
        int height = HeightBT(targetNode)-1;
        return max(height, timer);
    }
};
