Problem: Palindrome Linked List
Link: https://leetcode.com/problems/palindrome-linked-list/

Description:

Given the head of a singly linked list, return true if it is a palindrome or false otherwise.

Example 1:


Input: head = [1,2,2,1]
Output: true
Example 2:


Input: head = [1,2]
Output: false
 

Constraints:

The number of nodes in the list is in the range [1, 105].
0 <= Node.val <= 9
 

Follow up: Could you do it in O(n) time and O(1) space?

CODE:

/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:

    ListNode* reverseList(ListNode* head) {

        //1st Approach: (Using extra space)
        //Store the elements in vector/arr,
        //Perform palindrome check

        //2nd Approach:
        //In-Place Palindrome Check

        if(head==NULL)
        return NULL;

            ListNode* prev = NULL;
            ListNode* curr = head;
            ListNode* temp;
            while(curr->next) {
                temp = curr->next;
                curr->next = prev;
                prev = curr;
                curr = temp;
            }
            curr->next = prev;
            return curr;
    }

    bool isPalindrome(ListNode* head) {

        if(!head->next)
        return true;

        int count = 1;
        ListNode* tail = head;
        while(tail->next) {
            count+=1;
            tail = tail->next;
        }

       count/=2;
       tail = head;
       ListNode* prev = NULL;
       while(count--) {
            prev = tail;
            tail = tail->next;
       } 

        prev->next = NULL;

        //Reversing the list2 iteratively.
        prev = NULL;
        while(tail) {
            ListNode* fut = tail->next;
            tail->next = prev;
            prev = tail;
            tail = fut;
        }

        ListNode* head2 = prev;

       //reverse list2 (Using Recursion)
    //    ListNode* head2 = reverseList(tail);

       ListNode* head1 = head;

       while(head1 && head2) {
            if(head1->val != head2->val)
            return false;

            head1 = head1->next;
            head2 = head2->next;
       }

       return true;
    }
};
