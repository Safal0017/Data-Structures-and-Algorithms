Insert At Particular Position

CODE:

#include <iostream>
using namespace std;

class Node {
public:
    int data;
    Node* next;

    Node(int value) {
        data = value;
        next = NULL;
    }
};

// Creates a singly linked list from arr[size-1..0] using recursion (result is reversed).
Node* CreateLinkedList(int arr[], int index, int size, Node* prev) {
    if (index == size) return prev;

    Node* temp = new Node(arr[index]);
    temp->next = prev;
    return CreateLinkedList(arr, index + 1, size, temp);
}

void printLinkedList(Node* head) {
    Node* temp = head;
    while (temp) {
        cout << temp->data << " ";
        temp = temp->next;
    }
    cout << endl;
}

// Iterative insertion at 0-based position `pos`
Node* insertAtPosition(Node* head, int pos, int x) {
    // Insert at head
    if (pos == 0) {
        Node* newNode = new Node(x);
        newNode->next = head;
        return newNode;
    }

    Node* temp = head;
    int currPos = 0;

    // Move to node just before desired position
    while (temp && currPos < pos - 1) {
        temp = temp->next;
        currPos++;
    }

    // If pos is greater than length, do nothing (or you could choose to insert at end)
    if (!temp) return head;

    Node* newNode = new Node(x);
    newNode->next = temp->next;
    temp->next = newNode;

    return head;
}

// Recursive insertion at 0-based position `pos`
Node* insertAtPositionRec(Node* head, int pos, int x) {
    // Base case: insert at head
    if (pos == 0) {
        Node* newNode = new Node(x);
        newNode->next = head;
        return newNode;
    }

    // If list ended before reaching pos, do nothing
    if (!head) return NULL;

    // Recurse on next with pos-1
    head->next = insertAtPositionRec(head->next, pos - 1, x);
    return head;
}

int main() {
    Node* Head = NULL;

    int arr[] = {2, 4, 6, 8, 10};
    int n = 5;

    Head = CreateLinkedList(arr, 0, n, Head);
    cout << "Initial list: ";
    printLinkedList(Head);

    // Insert 7 at position 2 (0-based): after 2 nodes
    Head = insertAtPosition(Head, 2, 7);
    cout << "After iterative insert at pos 2 (7): ";
    printLinkedList(Head);

    // Insert 9 at position 1 (0-based) using recursion
    Head = insertAtPositionRec(Head, 1, 9);
    cout << "After recursive insert at pos 1 (9): ";
    printLinkedList(Head);

    return 0;
}
