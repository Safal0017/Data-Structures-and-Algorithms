        // }
        
        // return head;
        
        //2nd Approach:
        //Using MergeSort Logic.
        //T.C: 0(n*m * (logm))
        if(arr.size()==0)
        return NULL;

        MergeSort(arr, 0, arr.size()-1);
        return arr[0];
    }
};

