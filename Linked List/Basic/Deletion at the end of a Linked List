    }
};
*/
class Solution {
  public:
    Node* removeLastNode(Node* head) {
        // code here
        
        if(!head)
        return NULL;
        
        //Single Node
        if(!head->next)
        return NULL;
        
        Node* prev = NULL;
        Node* tail = head;
        while(tail->next) {
            prev = tail;
            tail = tail->next;
        }
        
        prev->next = NULL;
        delete tail;
        return head;
    }
};
