Search in a row wise and column wise sorted matrix
Link: https://www.geeksforgeeks.org/problems/search-in-a-matrix17201720/1

CODE:

// User function template for C++
class Solution {
  public:
    bool matSearch(vector<vector<int>> &matrix, int target) {
        // your code here
        //1st Approach: Brute-force Approach 0(n*m)
        
        //2nd Approach:
        // use the staircase search approach: (either top-right or bottom-left)
        //we can make a decision standing at any particular element

        // Start from the top-right element.
        // If the target is smaller, move left.
        // If the target is larger, move down.
        // Stop when found or out of bounds.


        int row = matrix.size();
        int col = matrix[0].size();
        
        int top = 0, right = col-1;
        while(top < row && right >= 0) {
            if(matrix[top][right] == target)
            return 1;
            else if(matrix[top][right] < target)
            top++;
            else 
            right--;
        }
        
        return 0;
    }
};
