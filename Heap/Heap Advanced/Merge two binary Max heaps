Merge two binary Max heaps
Link: https://www.geeksforgeeks.org/problems/merge-two-binary-max-heap0144/1

Problem Description:
Given two binary max heaps as arrays, merge the given heaps to form a new max heap.

Your Task:  
You don't need to read input or print anything. Your task is to complete the function mergeHeaps() which takes the array a[], b[], 
its size n and m, as inputs and return the merged max heap. Since there can be multiple solutions, therefore, 
to check for the correctness of your solution, your answer will be checked by the driver code and will return 1 if it is correct, else it returns 0.


Constraints:
1 <= n, m <= 105
1 <= a[i], b[i] <= 2*105

CODE:

// User function Template for C++

class Solution {
  public:
  
    void Heapify(vector<int> &ans, int index, int n) {
        
        while(true) {
            int largest = index;
            int left = 2*index+1;
            int right = 2*index+2;
            
            if(left<n&&ans[left]>ans[largest])
            largest = left;
            
            if(right<n&&ans[right]>ans[largest])
            largest = right;
            
            if(largest==index)
            break;
            
            if(largest!=index) {
                swap(ans[largest], ans[index]);
                index = largest;
            }
            
        }
        
    }
  
    vector<int> mergeHeaps(vector<int> &a, vector<int> &b, int n, int m) {
        // your code here
        vector<int> ans;
        
        for(int i=0;i<n;i++) {
            ans.push_back(a[i]);
        }
        
        for(int i=0;i<m;i++) {
            ans.push_back(b[i]);
        }
        
        int x = ans.size();
        
        for(int i=x/2-1;i>=0;i--) {
            Heapify(ans, i, x);
        }
        
        return ans;
    }
};
