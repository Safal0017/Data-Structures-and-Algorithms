Problem: Clone a LL with random pointer (Optimized Soln-InPlace)
Link: 
https://leetcode.com/problems/copy-list-with-random-pointer/
https://www.geeksforgeeks.org/problems/clone-a-linked-list-with-next-and-random-pointer/1

CODE:

/*
// Definition for a Node.
class Node {
public:
    int val;
    Node* next;
    Node* random;
    
    Node(int _val) {
        val = _val;
        next = NULL;
        random = NULL;
    }
};
*/

class Solution {
public:

    Node* copyRandomList(Node* head) {
        //1st Approach: T.C: 0(n^2), S.C: 0(1)
        //i. Create a LL without random pointers,
        //ii. Assign random pointer from start.

        //2nd Approach:
        //Using HashMap. T.C: 0(n), S.C: 0(n)
        //Similar to Approach-1, 
        //Only difference is, we will map the addresses
        //(originalNodeAddr-CloneNodeAddr) using unordered_map
        //i. Create a LL without random pointer.
        //ii. Map the addresses.
        //iii. Assign random pointer.

        //3rd Approach: Optimized T.C: 0(n), S.C: 0(1)
        // i. Create LL without random pointer
        // ii. Insert Cloned LL nodes into original
        // iii. Assigning *random to the nodes in the cloned LL.
        // iv. Disconnect clone list from original list.

        if(!head)
        return NULL;

        //Edge case:
        // Input
        // head =
        // [[-1,0]]

        // Use Testcase
        // Output
        // [[-1,null]]
        // Expected
        // [[-1,0]]

        // if(!head->next)
        // return new Node(head->val);

        //i.
        Node* headCopy = new Node(0);
        Node* tailCopy = headCopy;
        Node* temp = head;
        while(temp) {
            tailCopy->next = new Node(temp->val);
            tailCopy = tailCopy->next;
            temp = temp->next;
        }
        tailCopy = headCopy;
        headCopy = headCopy->next;
        delete tailCopy;


        // ii. 
        //Inserting them into an original LL.
        Node *curr1 = head, *curr2 = headCopy;
        Node *front1, *front2;
        while(curr1) {
            front1 = curr1->next;
            front2 = curr2->next;
            curr1->next = curr2;
            curr2->next = front1;
            curr1 = front1;
            curr2 = front2;
        }

        // iii. 
        // Assigning random pointer to the cloned LL
        curr1 = head;
        while(curr1) {
            curr2 = curr1->next;
            if(curr1->random)
            curr2->random = curr1->random->next;

            curr1 = curr2->next;
        }
        
        // iv. 
        //Disconnecting original from cloned LL
        // (whether original node/clone node, disjoining happens in same manner.)

        curr1 = head;
        while(curr1->next) {
            front1 = curr1->next;
            curr1->next = front1->next;
            curr1 = front1;
        }

        return headCopy;
    }
};
