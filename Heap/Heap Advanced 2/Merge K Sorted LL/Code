        // return head;
        
        //2nd Approach:
        //Using MergeSort Logic.
        //T.C: 0(n*m * (logm))
        //S.C: 0(logm) for recursion,
        // MergeSort(arr, 0, arr.size()-1);
        // return arr[0];
        
        // 3rd Approach:
        // Using Simple MinHeap Method,
        // dumping all nm nodes into the minHeap (if Step-Down -> 0(nm)) & 
        // one by one retrieval,
        // T.C: 0(nm + nmlognm)
        // S.C: 0(nm)
        
        // 4th Approach: 
        // i. First n elements into the minHeap
        //   (step-down: 0(n) or step-up: 0(nlogn))
        // ii. Total Elements: nm,
        //     Among which n is already inserted so
        //     (nm-n)*2logn
        //     =>T.C: nlogn + nmlogn-nlogn ~ 0(nmlogn)
        //     =>S.C: 0(n)
        //NOTE: MinHeap will store addresses of the Node and not value,
        //but the operations will be performed based on data/values using a comparator.
        
        priority_queue<Node*, vector<Node*>, Compare> p(arr.begin(), arr.end());
        
        Node* root = new Node(0);
        Node* tail = root;
        Node* temp;
        
        while(!p.empty()) {
            temp = p.top();
            p.pop();
            
            tail->next = temp;
            tail = tail->next;
            
            if(temp->next)
            p.push(temp->next);
        }
        
        return root->next;
        
        
    }
