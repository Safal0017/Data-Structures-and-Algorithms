Problem: Merge k Sorted Arrays

Optimized MinHeap Approach (combined with pair),

Link:
https://www.geeksforgeeks.org/problems/merge-k-sorted-arrays/1
Multiple Approaches: https://www.geeksforgeeks.org/dsa/merge-k-sorted-arrays/

CODE:

class Solution {
  public:
    vector<int> mergeArrays(vector<vector<int>> &arr) {
        // Code here
        
        int row = arr.size();
        int col = arr[0].size();
        
        // Brute-force Approaches:
        // All elements in 1D Arr (row*col)
        // + Sort them.
        // 1. Merge Sort
        //   for nm elements,
        //   T.C: 0(nmlognm)
        //   S.C: 0(nm) + 0(lognm) [Merge func + Recursive calls]
        // 2. Heap Sort
        //   for nm elements,
        //   T.C: 0(nmlognm) 
        //   S.C: 0(1)
           
        
        // 3rd Approach: 
        // Using MinHeap for all elements
        // 0(nm) for insertion (step-down)
        // +
        // 0(nmlognm) for deletion of nm elements
        // => T.C: 0(nmlognm)
        // => S.C: 0(nm) (Auxiliary Space)
        // No Utilization of Sorted Property.
        
        // 4th Approach:
        // Each row is sorted in itself so,
        // i. Inserting (col) elements into the heap,
        //   T.C: 0(col) if step-down else 0(collog(col)) for step-up
        //   Simplifying: 0(k)
        // ii. Remaining elements: 
        //     (row*col-col)
        //     Simplying:
        //     0(k^2-k) * logk for deletions
        //     So Overall,
        //     T.C: 0(k^2logk)
        //     S.C: 0(k)
            
        // pair: data, row, col
        
        vector<pair<int, pair<int, int>>> temp;
        for(int i=0;i<row;i++) {
            temp.push_back(make_pair(arr[i][0], make_pair(i,0)));
        }
        
        //Normal MinHeap
        // priority_queue<int, vector<int>, greater<int>> p
        
        //Our Use-Case
        // pair<int,pair<int,int>>
        priority_queue<pair<int,pair<int,int>>, vector<pair<int,pair<int,int>>>, greater<pair<int,pair<int,int>>>> p(temp.begin(), temp.end());
        
        vector<int> ans;
        
        pair<int,pair<int, int>> Element;
        int i, j;
        while(!p.empty()) {
            Element = p.top();
            p.pop();
            
            ans.push_back(Element.first);
            i = Element.second.first;
            j = Element.second.second;
            
            if(j+1<col)
            p.push(make_pair(arr[i][j+1], make_pair(i, j+1)));
        }
        
        return ans;
        
        
        
    }
};
