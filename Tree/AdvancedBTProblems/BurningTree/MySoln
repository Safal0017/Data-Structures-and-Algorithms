Burning Tree My Solution:
Leetcode: https://leetcode.com/problems/amount-of-time-for-binary-tree-to-be-infected/

/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left),
 * right(right) {}
 * };
 */
class Solution {

public:

    int heightBT(TreeNode* root) {
        if(!root)
        return 0;

        return 1+max(heightBT(root->left), heightBT(root->right));
    }

    bool findPath(TreeNode* root, int start, vector<TreeNode*> &rootToNode) {
        if(!root)
        return 0;

        if(root->val == start) {
            rootToNode.push_back(root);
            return 1;
        }

        if(findPath(root->left, start, rootToNode) || findPath(root->right, start, rootToNode)) {
            rootToNode.push_back(root);
            return 1;           
        }

        return 0;
    }

    void findTime(TreeNode* root, vector<TreeNode*> &rootToNode, int &maxHeight, int &currHeight, int index) {
        
        //Possibilities:
        // i. root is null
        // ii. towards. (call the same function, index+1, currHeight decrement)
        // iii. away. (simply call the heightBT func from that root node + currHeight, update maxHeight)
        // iv. root->val == rootToNode[index] && index == rootToNode.size()-1, calculate height as usual of childNodes

        if(!root)
        return;

        //Array exists
        if(root->val == rootToNode[index]->val) {
            //3 possibilities: away or towards, or index == rootToNode.size()-1;

            // 1. root->val == target, calculate it's beneath
            // 2.  i.  Awayside: left, towards: right (calculate left, move to the right)
            //     ii. Awayside: right, towards: left (calculate right, move to the left)
            // 3. Only right Subtree (Obviously towards so call)
            // 4. Only left Subtree (Obviously towards so call)

            //root->val == target
            if(index == rootToNode.size()-1) {
                int height = max(heightBT(root->left), heightBT(root->right));
                maxHeight = max(maxHeight, currHeight+height);
                 cout<<height<<" "<<maxHeight<<endl;
                return;
            }
            if(root->left && root->right && root->left->val != rootToNode[index+1]->val && root->right->val == rootToNode[index+1]->val) {
                int height = heightBT(root->left);
                maxHeight = max(maxHeight, currHeight+height);
                currHeight = currHeight-1;
                findTime(root->right, rootToNode, maxHeight, currHeight, index+1);
            } else if(root->left && root->right && root->right->val != rootToNode[index+1]->val && root->left->val == rootToNode[index+1]->val) {
                int height = heightBT(root->right);
                maxHeight = max(maxHeight, currHeight+height);
                currHeight = currHeight-1;
                findTime(root->left, rootToNode, maxHeight, currHeight, index+1);
            }

            // && root->right && root->right->val == rootToNode[index+1]->val
            if(!root->left) { //Only rightSubtree exists, (Obviously towards size)
                currHeight = currHeight-1;
                findTime(root->right, rootToNode, maxHeight, currHeight, index+1);
            } else {  //Only leftSubtree exists, (Obviously towards size)
                currHeight = currHeight-1;
                findTime(root->left, rootToNode, maxHeight, currHeight, index+1);
            }
        }

    }

    int amountOfTime(TreeNode* root, int start) {

        if(!root)
        return 0;

        if(root->val == start){
            return max(heightBT(root->left), heightBT(root->right));
        }

        vector<TreeNode*> rootToNode;
        findPath(root, start, rootToNode);
        reverse(rootToNode.begin(), rootToNode.end());
        for(int i=0;i<rootToNode.size();i++){
            cout<<rootToNode[i]->val<<" ";
        }
        cout<<endl;
        // return 0;

        int currHeight = rootToNode.size()-1;
        int maxHeight = rootToNode.size()-1;
        //baseHeight, maxHeight, currHeight
        cout<<maxHeight<<endl;
        findTime(root, rootToNode, maxHeight, currHeight, 0);
        return maxHeight;
    }
};
