        //3rd Approach, 0(log(n*m))
        //Considering the 2D matrix being stored in a linear contiguous manner inside memory
        //and applying binary search over that 1D array, in turn utilizes the 
        //row-sorted & column-sorted property of matrix.
        //By default, C++/Java follows row-major order to store 2D array elements,
        //Index Calculation formula for row-major:
        //Index = row_index*col+col_index.
        
        int row = matrix.size();
        int col = matrix[0].size();

        int start = 0;
        int end = row*col-1;
        while(start<=end) {
            int mid = start + (end-start)/2;
            //finding row_index & column_index using formula.
            int row_index = mid/col;
            int col_index = mid%col;
            if(matrix[row_index][col_index]==target)
            return 1;
            else if(matrix[row_index][col_index] < target)
            start = mid+1;
            else
            end = mid-1;
        }

        return 0;

    }
